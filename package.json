{
	"name": "xrplmeta",
	"version": "2.25.0-alpha",
	"type": "module",
	"bin": {
		"xrplmeta": "./src/run.js"
	},
	"scripts": {
		"start": "node src/run.js",
		"postinstall": "npm run build-deps",
		"build-deps": "node-gyp rebuild --directory=deps --release",
		"test": "mocha --recursive 'test/unit/**/*.test.js'",
		"livetest": "node test/live/run.js",
		"docker:build": "docker build -t xrplmeta/node ."
	},
	"dependencies": {
		"@mwni/events": "3.1.0",
		"@mwni/log": "3.5.1",
		"@mwni/workers": "1.1.0",
		"@structdb/sqlite": "1.7.2-alpha",
		"@xrplkit/socket": "2.1.0",
		"@xrplkit/time": "1.0.0",
		"@xrplkit/tokens": "1.1.0",
		"@xrplkit/toml": "1.0.0",
		"@xrplkit/txmeta": "1.5.0",
		"@xrplkit/xfl": "2.1.2",
		"@xrplkit/xls26": "2.6.0",
		"@xrplkit/xls89": "0.2.0",
		"@koa/router": "15.4.0",
		"koa": "3.2.0",
		"koa-easy-ws": "2.1.0",
		"koa-json": "2.0.2",
		"koa-send": "5.0.1",
		"better-sqlite3": "12.9.0",
		"limiter": "3.0.0",
		"node-abort-controller": "3.1.1",
		"node-fetch": "3.3.2",
		"minimist": "1.2.8",
		"ripple-address-codec": "5.0.0",
		"sharp": "0.34.5",
		"ws": "8.20.0"
	},
	"devDependencies": {
		"chai": "6.2.2",
		"mocha": "11.7.5"
	}
}
